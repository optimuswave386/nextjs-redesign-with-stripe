# Get a free key at https://api.nasa.gov — DEMO_KEY works but is heavily rate limited.
NASA_API_KEY=DEMO_KEY

# Required by NextAuth/Auth.js to sign session tokens. Generate one with:
#   npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=

# MongoDB connection string (Atlas or self-hosted). Leave unset to use the built-in sample data.
MONGODB_URI=
# Database name (defaults to "site").
MONGODB_DB=site

# The public URL of this deployment (no trailing slash). Used to build Stripe's
# success/cancel redirect URLs. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the signing secret Stripe shows
# when you add a webhook endpoint in the dashboard for checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# Outgoing email (nodemailer) — works with any SMTP provider: Gmail (with an app
# password), SendGrid, Mailgun, Postmark, Resend's SMTP endpoint, Mailtrap for testing…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Site <no-reply@example.com>"
# Where help-center reports land. Defaults to the address in src/lib/site.ts.
SUPPORT_EMAIL=

# Environment is development or production
NODE_ENV=development
